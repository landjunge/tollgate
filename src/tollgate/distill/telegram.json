{
  "id": "telegram",
  "title": "Telegram Bot API",
  "distilled_at": "2026-08-11",
  "sources": ["https://core.telegram.org/bots/api"],
  "openai_compatible": false,
  "auth": {
    "type": "path_token",
    "env": ["TELEGRAM_BOT_TOKEN"],
    "meta_env": ["TELEGRAM_ALLOWED_CHAT_IDS", "TELEGRAM_HOME_CHANNEL"],
    "summary": "bot token in getMe URL path"
  },
  "base_urls": {
    "default": "https://api.telegram.org"
  },
  "endpoints": [
    {
      "id": "getMe",
      "method": "GET",
      "path": "/bot<token>/getMe",
      "cost": "none",
      "purpose": "Validate token"
    }
  ],
  "limits": {
    "note": "Optional for hub; empty is OK",
    "probe_kind": "free"
  },
  "errors": {
    "401": "unauthorized bot token"
  },
  "ops": [
    { "name": "status", "maps_to": "getMe", "args": ["live"] },
    { "name": "research", "maps_to": "distill", "args": [] }
  ],
  "gotchas": [
    "TELEGRAM_ALLOWED_CHAT_IDS allowlist when enabled",
    "Optional — grade F empty is acceptable"
  ],
  "hub": {
    "probe": "GET https://api.telegram.org/bot<token>/getMe",
    "probe_kind": "free",
    "probe_cost": "none",
    "capabilities": ["optional"]
  }
}
